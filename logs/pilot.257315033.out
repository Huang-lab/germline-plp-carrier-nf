Command executed:

  set -euo pipefail
  if command -v vep >/dev/null 2>&1; then
      # --custom VCF tracks need a tabix index adjacent to the file. Nextflow
      # stages the .vcf.gz but not its index, so build one in the task dir if
      # absent (tabix ships with the VEP container's htslib).
      for f in "clinvar_20250715.vcf.gz" ".empty__gnomad_vcf"; do
          if [ -s "$f" ] && [ ! -e "$f.tbi" ] && [ ! -e "$f.csi" ]; then
              tabix -p vcf "$f" || true
          fi
      done
  
      # Build optional tracks/plugins ONLY for references actually supplied.
      # Unused optional inputs are 0-byte placeholders (see main.nf optionalFile),
      # so a size test cleanly enables/disables each one.
      EXTRA=""
      if [ -s "clinvar_20250715.vcf.gz" ]; then
          EXTRA="$EXTRA --custom clinvar_20250715.vcf.gz,ClinVar,vcf,exact,0,CLNSIG,CLNREVSTAT"
      fi
      if [ -s ".empty__gnomad_vcf" ]; then
          EXTRA="$EXTRA --custom .empty__gnomad_vcf,gnomAD,vcf,exact,0,AF,AF_grpmax"
      fi
      if [ -s ".empty__am_data_tsv" ]; then
          EXTRA="$EXTRA --dir_plugins $(dirname $(readlink -f .empty__am_plugin_pm)) --plugin AlphaMissense,file=.empty__am_data_tsv"
      fi
      if [ -s ".empty__loftee_data_dir/human_ancestor.fa.gz" ]; then
          EXTRA="$EXTRA --plugin LoF,loftee_path:/opt/loftee,human_ancestor_fa:.empty__loftee_data_dir/human_ancestor.fa.gz"
      fi
  
      vep --input_file Targeted_MSM_b001_260_chr10_133546508_133797422.norm.vcf --output_file Targeted_MSM_b001_260_chr10_133546508_133797422.vep.vcf --vcf \
          --force_overwrite --no_stats --offline --cache \
          --dir_cache vep_cache --cache_version 113 \
          --species homo_sapiens --assembly GRCh38 \
          --fasta Homo_sapiens.GRCh38.dna.primary_assembly.fa.bgz \
          --symbol --canonical --mane \
          --pick --pick_order mane_select,canonical,tsl,biotype,rank,ccds,length \
          --fork 1 \
          $EXTRA
  else
      # Test-profile fallback: synthesize a minimal VEP-like CSQ header + a CSQ INFO tag
      # for each variant, using SYMBOL from a fixed lookup table in the fixture.
      python3 /sc/arion/projects/rg_huangk06/variants_PLP_MSM/germline-plp-carrier-nf/bin/synthetic_vep.py --in Targeted_MSM_b001_260_chr10_133546508_133797422.norm.vcf --out Targeted_MSM_b001_260_chr10_133546508_133797422.vep.vcf
  fi

