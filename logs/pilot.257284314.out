  set -euo pipefail
  if command -v bcftools >/dev/null 2>&1 && [ -s "Homo_sapiens.GRCh38.dna.primary_assembly.fa.bgz" ]; then
      # Contig-naming reconciliation. The reference FASTA, VEP cache, and NCBI
      # ClinVar are Ensembl-style (1,2,...,X,Y,MT); input VCFs may be UCSC-style
      # (chr1,...,chrM). Build a rename map from the VCF's own chr-prefixed
      # contigs so everything downstream is in one naming space.
      bcftools view -h Targeted_MSM_b001_260_chr10_133546508_133797422.vcf.gz \
        | awk -F'[=,>]' '/^##contig/{for(i=1;i<=NF;i++) if($i=="ID"){print $(i+1)}}' \
        > contigs.txt
      : > chr_map.txt
      while read -r c; do
          case "$c" in
              chrM|chrMT) printf '%s\tMT\n'  "$c" >> chr_map.txt ;;
              chr*)       printf '%s\t%s\n' "$c" "${c#chr}" >> chr_map.txt ;;
          esac
      done < contigs.txt
  
      if [ -s chr_map.txt ]; then
          bcftools annotate --rename-chrs chr_map.txt Targeted_MSM_b001_260_chr10_133546508_133797422.vcf.gz -Oz -o renamed.vcf.gz
          SRC=renamed.vcf.gz
      else
          SRC=Targeted_MSM_b001_260_chr10_133546508_133797422.vcf.gz
      fi
  
      bcftools norm -m -any -f Homo_sapiens.GRCh38.dna.primary_assembly.fa.bgz "$SRC" -Ov \
        | bcftools view -f PASS,. -Ov \
        | bcftools +setGT -Ov -- \
            -t q -n . \
            -i 'FMT/DP<10 | FMT/GQ<20' \
        > Targeted_MSM_b001_260_chr10_133546508_133797422.norm.vcf
  else
      # Test-profile fallback: no bcftools available; passthrough while asserting the file is a VCF.
      head -c 4 Targeted_MSM_b001_260_chr10_133546508_133797422.vcf.gz | grep -q '##' || { echo "not a VCF"; exit 2; }
      cp Targeted_MSM_b001_260_chr10_133546508_133797422.vcf.gz Targeted_MSM_b001_260_chr10_133546508_133797422.norm.vcf
  fi

