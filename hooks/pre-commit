#!/usr/bin/env bash
# germline-plp-carrier-nf pre-commit hook
# Blocks staging of participant / reference data and real sample IDs.
# Install: ln -s ../../hooks/pre-commit .git/hooks/pre-commit
set -euo pipefail

DATA_RE='\.(vcf(\.gz|\.bgz)?(\.tbi|\.csi)?|bcf(\.csi)?|bgen|bed|bim|fam|cram(\.crai)?|bam(\.bai)?)$'
ID_RE='(^|/)(SINAI_|SINAI-Million_)'
EXEMPT_RE='^tests/synthetic/'

fail=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if [[ "$f" =~ $EXEMPT_RE ]]; then
    continue
  fi
  if [[ "$f" =~ $DATA_RE ]]; then
    echo "pre-commit: BLOCKED data-shaped file: $f" >&2
    fail=1
  fi
  if [[ "$f" =~ $ID_RE ]]; then
    echo "pre-commit: BLOCKED real sample-ID pattern in path: $f" >&2
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# Scan added text lines for real sample-ID patterns (fixtures exempt).
if git diff --cached -U0 --diff-filter=ACM -- ':!tests/synthetic' | \
     grep -E '^\+' | grep -vE '^\+\+\+' | \
     grep -E '(SINAI_[A-Za-z0-9]+|SINAI-Million_[A-Za-z0-9]+)' >/dev/null; then
  echo "pre-commit: BLOCKED real sample-ID pattern in diff content" >&2
  fail=1
fi

exit $fail
