/*
 * Minerva HPC (Mount Sinai) profile — LSF + Singularity.
 * Structure follows nf-core/configs conf/mssm.config
 *   https://github.com/nf-core/configs/blob/master/conf/mssm.config
 * (Author of mssm.config: Christopher Tastad, Judy Cho Lab.)
 *
 * Requires: export MINERVA_ALLOCATION="acc_YOUR-PROJECT-NAME"
 * Minerva login/compute nodes have direct internet access — do NOT set
 * http_proxy/https_proxy unless you know you're on a subnet that needs it.
 */

def allocation = System.getenv('MINERVA_ALLOCATION') ?: 'acc_UNSET'

env {
    SINGULARITY_CACHEDIR      = "/sc/arion/work/${System.getenv('USER')}/singularity_cache"
    SINGULARITY_TMPDIR        = "/sc/arion/work/${System.getenv('USER')}/singularity_tmp"
    SINGULARITY_LOCALCACHEDIR = "/sc/arion/work/${System.getenv('USER')}/singularity_cache"
    SINGULARITY_PULLFOLDER    = "/sc/arion/work/${System.getenv('USER')}/singularity_cache/pull"
    SINGULARITY_DISABLE_CACHE = "no"
}

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = "/sc/arion/work/${System.getenv('USER')}/singularity_cache"
    pullTimeout = '120 min'
    // Pass any proxy env vars from the shell through to the container (harmless if unset).
    envWhitelist = ['http_proxy', 'https_proxy', 'all_proxy', 'no_proxy',
                    'HTTP_PROXY', 'HTTPS_PROXY', 'NO_PROXY']
}

executor {
    name            = 'lsf'
    submitRateLimit = '2 sec'
    perJobMemLimit  = false
    perTaskReserve  = true
    queueSize       = 200
    pollInterval    = '30 sec'
}

process {
    executor = 'lsf'
    scratch  = true

    // Dynamic queue selection (mirrors nf-core mssm).
    queue = {
        if (task.time > 144.h)                             return 'long'
        if (task.label?.toString()?.contains('gpu') && task.time <= 30.min) return 'gpuexpress'
        if (task.label?.toString()?.contains('gpu'))       return 'gpu'
        if (task.time <= 12.h && task.cpus <= 8)           return 'express'
        return 'premium'
    }

    clusterOptions = {
        def opts = "-P ${allocation}"
        if (task.memory) opts += " -M ${task.memory.toMega()}"
        return opts
    }

    // Dynamic retry — matches nf-core mssm policy.
    errorStrategy = {
        if (task.exitStatus in [130, 137, 140]      && task.attempt <= 3) return 'retry'
        if (task.exitStatus in (131..145)           && task.attempt <= 1) return 'retry'
        return 'finish'
    }
    maxRetries = 3

    // Container assignments per pipeline label.
    // Default: pre-built public biocontainers pulled directly by Singularity
    // (no root/fakeroot required). Override via params.container_* if you
    // have a locally-built .sif you want to use instead.
    withLabel: vep     { container = params.container_annotate ?: 'docker://ensemblorg/ensembl-vep:release_113.0' }
    withLabel: bcf     { container = params.container_annotate ?: 'docker://staphb/bcftools:1.20' }
    withLabel: py      { container = params.container_annotate ?: 'docker://python:3.11-slim' }
    withLabel: annovar { container = params.container_annovar_intervar ?: '' }
}

workDir = "/sc/arion/scratch/${System.getenv('USER')}/nf-germline-plp-carrier"
