// Minerva (LSF + Singularity) — modeled on nf-core mssm defaults.
// Requires MINERVA_ALLOCATION to be exported before submission.

def allocation = System.getenv('MINERVA_ALLOCATION') ?: 'acc_UNSET'

executor {
    name              = 'lsf'
    submitRateLimit   = '2 sec'
    perJobMemLimit    = false
    perTaskReserve    = true
    queueSize         = 200
    pollInterval      = '30 sec'
}

process {
    executor      = 'lsf'
    scratch       = true
    // Queue chosen dynamically by walltime.
    queue         = { task.time <= 12.h ? 'express'
                     : (task.time <= 144.h ? 'premium' : 'long') }
    clusterOptions = { "-P ${allocation} -M ${(task.memory ?: 4.GB).toMega()}" }
    errorStrategy  = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries     = 3

    withLabel: vep    { container = params.container_annotate }
    withLabel: bcf    { container = params.container_annotate }
    withLabel: annovar { container = params.container_annovar_intervar }
    withLabel: py     { container = params.container_annotate }
}

singularity {
    enabled       = true
    autoMounts    = true
    cacheDir      = "/sc/arion/work/${System.getenv('USER')}/singularity_cache"
    envWhitelist  = ['http_proxy', 'https_proxy', 'all_proxy', 'no_proxy',
                     'HTTP_PROXY', 'HTTPS_PROXY', 'NO_PROXY']
    runOptions    = '--nv'
}

workDir = "/sc/arion/scratch/${System.getenv('USER')}/nf-germline-plp-carrier"
