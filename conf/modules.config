// Per-process resource label, container, and publishDir.
// Each process gets ONE resource label (from conf/base.config) and an explicit
// container. On Minerva set params.container_* to local .sif paths; otherwise
// these docker:// URLs are pulled by Nextflow.
//
// Container assignment is intentionally 1 image per process (no process needs
// two toolsets): bcftools-only, vep-only, or python-only.

def img_vep = { params.container_vep ?: 'docker://ensemblorg/ensembl-vep:release_113.0' }
def img_bcf = { params.container_bcftools ?: 'docker://staphb/bcftools:1.20' }
def img_py  = { params.container_python ?: 'docker://python:3.11-slim' }
def img_ann = { params.container_annovar_intervar ?: '' }

process {
    withName: 'NORM_QC' {
        label      = 'medium'
        cpus       = 2
        memory     = { 8.GB * task.attempt }
        time       = { 6.h * task.attempt }
        container  = img_bcf()
        publishDir = [ path: { "${params.outdir}/norm_qc" }, mode: 'copy' ]
    }
    withName: 'VEP_ANNOTATE' {
        label      = 'vep'
        // Set explicitly (do not rely on withLabel matching a config-assigned label).
        // Pin to premium: single-threaded VEP on large chunks exceeds the
        // express-queue walltime, causing a killed first attempt + retry on
        // every chunk (huge CPU waste). premium honors the requested walltime.
        queue      = 'premium'
        cpus       = 2
        memory     = { 24.GB * task.attempt }
        time       = { 24.h * task.attempt }
        container  = img_vep()
        // VEP output is a large intermediate consumed only internally — do NOT
        // publish a second full copy (was a major disk hog). The QC'd VCFs
        // (norm_qc, bgzipped) and the TSV results are what get published.
    }
    withName: 'VALIDATE_CHUNK' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/validation" }, mode: 'copy' ]
    }
    withName: 'CLINVAR_CLASSIFY' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/variants" }, mode: 'copy' ]
    }
    withName: 'ALPHAMISSENSE_CLASSIFY' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/variants" }, mode: 'copy' ]
    }
    withName: 'ACMG_ANNOVAR_INTERVAR' {
        label      = 'annovar'
        container  = img_ann()
        publishDir = [
            [ path: { "${params.outdir}/variants" },         mode: 'copy', pattern: "*.acmg_plp.tsv" ],
            [ path: { "${params.outdir}/annovar_intervar" }, mode: 'copy', pattern: "*.hg38_multianno.txt" ],
            [ path: { "${params.outdir}/annovar_intervar" }, mode: 'copy', pattern: "*.intervar" ],
        ]
    }
    withName: 'PER_GENE_QC' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/variants" }, mode: 'copy' ]
    }
    withName: 'CARRIER_GT' {
        // bcftools C-speed genotype extraction at qualifying positions only.
        label      = 'medium'
        cpus       = 2
        memory     = { 8.GB * task.attempt }
        time       = { 6.h * task.attempt }
        container  = img_bcf()
        // gt.tsv is an intermediate; no publishDir.
    }
    withName: 'CARRIER_MATRIX' {
        // Pure-Python assembly (join GT to classifications, derive zygosity).
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/carriers" }, mode: 'copy' ]
    }
    withName: 'CONCAT_CARRIER_MATRIX' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/carriers" }, mode: 'copy' ]
    }
    withName: 'MANIFEST' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}" }, mode: 'copy' ]
    }
}
