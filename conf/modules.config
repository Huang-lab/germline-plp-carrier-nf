// Per-process resource label, container, and publishDir.
// Each process gets ONE resource label (from conf/base.config) and an explicit
// container. On Minerva set params.container_* to local .sif paths; otherwise
// these docker:// URLs are pulled by Nextflow.
//
// Container assignment is intentionally 1 image per process (no process needs
// two toolsets): bcftools-only, vep-only, or python-only.

def img_vep = { params.container_vep ?: 'docker://ensemblorg/ensembl-vep:release_113.0' }
def img_bcf = { params.container_bcftools ?: 'docker://staphb/bcftools:1.20' }
def img_py  = { params.container_python ?: 'docker://python:3.11-slim' }
def img_ann = { params.container_annovar_intervar ?: '' }

process {
    withName: 'NORM_QC' {
        label      = 'medium'
        container  = img_bcf()
        publishDir = [ path: { "${params.outdir}/norm_qc" }, mode: 'copy' ]
    }
    withName: 'VEP_ANNOTATE' {
        label      = 'vep'
        container  = img_vep()
        publishDir = [ path: { "${params.outdir}/vep" }, mode: 'copy' ]
    }
    withName: 'VALIDATE_CHUNK' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/validation" }, mode: 'copy' ]
    }
    withName: 'CLINVAR_CLASSIFY' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/variants" }, mode: 'copy' ]
    }
    withName: 'ALPHAMISSENSE_CLASSIFY' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/variants" }, mode: 'copy' ]
    }
    withName: 'ACMG_ANNOVAR_INTERVAR' {
        label      = 'annovar'
        container  = img_ann()
        publishDir = [ path: { "${params.outdir}/variants" }, mode: 'copy' ]
    }
    withName: 'PER_GENE_QC' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/variants" }, mode: 'copy' ]
    }
    withName: 'CARRIER_MATRIX' {
        // Pure-Python (reads bgzipped VCF via gzip); no bcftools dependency.
        label      = 'medium'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/carriers" }, mode: 'copy' ]
    }
    withName: 'CONCAT_CARRIER_MATRIX' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}/carriers" }, mode: 'copy' ]
    }
    withName: 'MANIFEST' {
        label      = 'small'
        container  = img_py()
        publishDir = [ path: { "${params.outdir}" }, mode: 'copy' ]
    }
}
