// germline-plp-carrier-nf — top-level Nextflow config
// Cohort-agnostic. Cohort params live under params/*.yaml.

manifest {
    name            = 'germline-plp-carrier-nf'
    description     = 'Variant→carrier pipeline: norm+QC → VEP → ClinVar/ACMG/AlphaMissense P/LP → per-person carrier matrices'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // Which P/LP classifiers to run. Any subset of ['clinvar','acmg','am'].
    // Comma-separated string or Groovy list. Empty selects all three.
    classifiers          = 'clinvar,acmg,am'

    // I/O
    input_vcfs           = null   // glob for VCF chunks (e.g. '/path/*.vcf.gz')
    reference_fasta      = null
    outdir               = 'results'
    keep_samples         = null   // optional sample keep-list (one ID per line)
    skip_norm_qc         = false  // inputs already normalized/QC'd; bypass NORM_QC

    // Cohort label — used in manifest only. Paths come from params/<cohort>.yaml.
    cohort               = null

    // References
    vep_cache_dir        = null
    vep_species          = 'homo_sapiens'
    vep_assembly         = 'GRCh38'
    vep_cache_version    = null
    clinvar_vcf          = null
    clinvar_release      = null   // e.g. '20260401' — MUST match ANNOVAR humandb clinvar_<date>
    gnomad_vcf           = null
    gnomad_version       = null   // e.g. 'v4.1'
    am_data_tsv          = null   // AlphaMissense_hg38.tsv.gz
    am_plugin_pm         = null   // VEP AlphaMissense plugin .pm
    am_calibration_tsv   = null   // Chen/Pejaver 2026 gene-specific thresholds (user-supplied)
    loftee_data_dir      = null   // ancestral FASTA, conservation/GERP

    // ANNOVAR/InterVar (paths on Minerva; not bundled)
    annovar_dir          = null
    annovar_humandb      = null
    intervar_dir         = null
    intervar_config      = null

    // Params (thresholds)
    min_dp               = 10
    min_gq               = 20
    het_ab_min           = 0.20
    het_ab_max           = 0.80
    hom_ab_min           = 0.90
    clinvar_min_stars    = 2
    am_min_strength      = 'PP3_Moderate'
    am_default_threshold = 0.564
    min_symbol_fraction  = 0.5
    gnomad_popmax_field  = 'AF_grpmax'

    // Containers. On Minerva, set these to the ABSOLUTE PATH of a .sif you
    // pulled once on a compute node (login nodes hit a thread limit during
    // OCI->SIF conversion). If left null, conf/modules.config falls back to a
    // docker:// URL that Nextflow will pull itself.
    container_vep              = null   // e.g. /sc/arion/work/$USER/singularity_cache/ensembl-vep_release_113.0.sif
    container_bcftools         = null   // e.g. .../bcftools_1.20.sif
    container_python           = null   // e.g. .../python_3.11-slim.sif
    container_annovar_intervar = null   // ACMG only
    container_annotate         = null   // legacy single-image override (unused by default)

    // Reporting only — never a filter
    cancer_gene_panel    = null

    // Nextflow timeline/report/trace/dag. Off by default (needs `ps` in every
    // container). Set true only if all containers include procps.
    enable_reports       = false

    // Emit a SYNTHETIC ACMG stub when ANNOVAR/InterVar isn't available. Only
    // for pipeline testing — real runs must configure ANNOVAR/InterVar and
    // leave this false, so a misconfigured ACMG run fails loudly.
    allow_stub_acmg      = false
}

// Enable process-level publishing configuration.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    minerva {
        includeConfig 'conf/minerva.config'
    }
    test {
        // Local, no-container profile driven by tests/synthetic fixtures.
        process.executor = 'local'
        singularity.enabled = false
        docker.enabled = false
        params {
            input_vcfs         = "${projectDir}/tests/synthetic/chunks/*.vcf"
            reference_fasta    = "${projectDir}/tests/synthetic/ref/synthetic.fa"
            keep_samples       = "${projectDir}/tests/synthetic/samples.keep.txt"
            am_calibration_tsv = "${projectDir}/tests/synthetic/am_calibration.tsv"
            outdir             = "${projectDir}/results-test"
            cohort             = 'synthetic'
            clinvar_release    = 'SYNTHETIC'
            gnomad_version     = 'SYNTHETIC'
            allow_stub_acmg    = true
        }
    }
}

// Pipeline reports are DISABLED by default: report/timeline/trace inject
// `ps`-based per-task metric collection into the task wrapper, which fails on
// minimal containers (python:slim, staphb/bcftools) that lack procps. Enable
// these only with containers that include `ps`. `params.enable_reports=true`
// flips them back on.
timeline { enabled = (params.enable_reports as boolean); overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = (params.enable_reports as boolean); overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = (params.enable_reports as boolean); overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = (params.enable_reports as boolean); overwrite = true; file = "${params.outdir}/pipeline_info/dag.dot" }
